[sub_resource type="Shader" id="Shader_ball_shadow"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;

uniform float shadow_alpha = 0.65;

void fragment() {
	vec2 centered = UV * 2.0 - 1.0;
	float r = length(centered);
	float falloff = 1.0 - smoothstep(0.15, 1.0, r);
	ALBEDO = vec3(0.0, 0.0, 0.0);
	ALPHA = falloff * shadow_alpha;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_ball_shadow"]
