[sub_resource type="Shader" id="Shader_ball"]
code = "shader_type spatial;
render_mode cull_back;

varying vec3 v_local;

void vertex() {
	v_local = normalize(VERTEX);
}

void fragment() {
	vec3 p = normalize(v_local);
	float phi = 1.61803399;
	float inv_len = inversesqrt(1.0 + phi * phi);
	float a = inv_len;
	float b = phi * inv_len;

	float max_d = -1.0;
	max_d = max(max_d, dot(p, vec3(0.0,  a,  b)));
	max_d = max(max_d, dot(p, vec3(0.0, -a,  b)));
	max_d = max(max_d, dot(p, vec3(0.0,  a, -b)));
	max_d = max(max_d, dot(p, vec3(0.0, -a, -b)));
	max_d = max(max_d, dot(p, vec3( a,  b, 0.0)));
	max_d = max(max_d, dot(p, vec3(-a,  b, 0.0)));
	max_d = max(max_d, dot(p, vec3( a, -b, 0.0)));
	max_d = max(max_d, dot(p, vec3(-a, -b, 0.0)));
	max_d = max(max_d, dot(p, vec3( b, 0.0,  a)));
	max_d = max(max_d, dot(p, vec3(-b, 0.0,  a)));
	max_d = max(max_d, dot(p, vec3( b, 0.0, -a)));
	max_d = max(max_d, dot(p, vec3(-b, 0.0, -a)));

	float fw = max(fwidth(max_d), 0.005);
	float pentagon = smoothstep(0.915 - fw, 0.915 + fw, max_d);
	vec3 white_panel = vec3(0.92, 0.92, 0.89);
	vec3 black_panel = vec3(0.02, 0.02, 0.03);
	ALBEDO = mix(white_panel, black_panel, pentagon);
	ROUGHNESS = mix(0.35, 0.45, pentagon);
}
"

