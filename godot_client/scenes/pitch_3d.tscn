[sub_resource type="Shader" id="Shader_carrier_ring"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;

void fragment() {
	vec2 centered = UV * 2.0 - 1.0;
	float r = length(centered);
	float d = abs(r - 0.78);
	float aa = max(fwidth(d), 0.02);
	float ring = 1.0 - smoothstep(0.09 - aa, 0.09 + aa, d);
	ALBEDO = vec3(1.0, 0.75, 0.12);
	ALPHA = ring * 0.9;
}
"

