{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-debug",
            "displayName": "Windows x64 Debug",
            "description": "Standard Debug build using MSVC and Ninja with embedded debug info",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
            },
            "environment": {
                "_CL_": "/Z7"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows x64 Release",
            "description": "Optimized Release build using MSVC and Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
            },
            "environment": {
                "_CL_": "/Z7"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
